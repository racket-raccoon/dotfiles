;;; Package setup and Customize settings

;; Set up package.el, add MELPA, and prefer GNU ELPA for Org.
(require 'package)
(add-to-list 'package-archives
	     '("melpa" . "https://melpa.org/packages/") t)
(add-to-list 'package-pinned-packages '(org . "gnu") t)
(package-initialize)

;; Options saved through Customize for Evil, Org, and package selection.
(custom-set-variables
 ;; custom-set-variables was added by Custom.
 ;; If you edit it by hand, you could mess it up, so be careful.
 ;; Your init file should contain only one such instance.
 ;; If there is more than one, they won't work right.
 '(evil-undo-system 'undo-redo)
 '(org-agenda-files '("/home/lv/org/learning.org"))
 '(org-clock-into-drawer "CLOCKING")
 '(org-log-into-drawer t)
 '(org-modules
   '(ol-bbdb ol-bibtex ol-docview ol-doi ol-eww ol-gnus org-habit ol-info
	     ol-irc ol-mhe ol-rmail ol-w3m))
 '(package-selected-packages '(evil evil-org magit org org-roam)))

;; Face settings saved through Customize (currently none).
(custom-set-faces
 ;; custom-set-faces was added by Custom.
 ;; If you edit it by hand, you could mess it up, so be careful.
 ;; Your init file should contain only one such instance.
 ;; If there is more than one, they won't work right.
 )

;;; Package bootstrap

;; On a new machine, install or upgrade Org and the selected packages.
(defun my/bootstrap-packages ()
  "Install selected packages and the GNU ELPA version of Org.
Run this from a clean Emacs process before opening an Org file."
  (interactive)
  (when (featurep 'org)
    (user-error "Run package bootstrap before opening an Org file"))
  (package-refresh-contents)
  (if (assq 'org package-alist)
      (package-upgrade 'org)
    (let ((package-install-upgrade-built-in t))
      (package-install 'org)))
  (package-install-selected-packages t))

;;; Keys and hints

;; Show available commands after prefix keys such as Space or C-c.
(which-key-mode 1)

;; Name the Space leader groups shown by which-key.
(which-key-add-key-based-replacements
 "SPC b" "buffer"
 "SPC f" "file"
 "SPC h" "help"
 "SPC h r" "reload")

(defun my/reload-init-file ()
  "Reload the current Emacs init file."
  (interactive)
  (load-file user-init-file))

;; Enable Vim keys and Space-leader shortcuts when Evil is installed.
;; A copied init.el can load before packages are bootstrapped.
(when (package-installed-p 'evil)
  (require 'evil)
  (evil-mode 1)
  (evil-set-leader 'normal (kbd "SPC"))
  (evil-define-key 'normal 'global (kbd "<leader>bb") #'switch-to-buffer)
  ;; Space b k kills the current buffer, asking about unsaved changes.
  (evil-define-key 'normal 'global (kbd "<leader>bk") #'kill-current-buffer)
  (evil-define-key 'normal 'global (kbd "<leader>ff") #'find-file)
  (evil-define-key 'normal 'global (kbd "<leader>fr") #'recentf-open)
  (evil-define-key 'normal 'global (kbd "<leader>hv") #'describe-variable)
  (evil-define-key 'normal 'global (kbd "<leader>hrr") #'my/reload-init-file)
  (evil-define-key 'normal 'global (kbd "<leader>:") #'execute-extended-command))

;; Use Org-aware Evil keys in Org files and agenda buffers.
(when (package-installed-p 'evil-org)
  (use-package evil-org
    :after org
    :hook (org-mode . evil-org-mode)
    :config
    (require 'evil-org-agenda)
    (evil-org-agenda-set-keys)))

;;; Org and calendar

;; Start calendar weeks on Monday.
(setq calendar-week-start-day 1)

;; Global Org shortcuts: store a link, open the agenda, and capture.
(global-set-key (kbd "C-c l") #'org-store-link)
(global-set-key (kbd "C-c a") #'org-agenda)
(global-set-key (kbd "C-c c") #'org-capture)

;; Expand <s TAB, <e TAB, and other Org structure templates.
(with-eval-after-load 'org
  (require 'org-tempo))

;; Accept y/n for Org prompts, including code block evaluation.
(add-hook 'org-mode-hook
          (lambda () (setq-local use-short-answers t)))

;; Wrap Org text at word boundaries and show relative line numbers there.
(setq display-line-numbers-type 'relative)
(add-hook 'org-mode-hook #'visual-line-mode)
(add-hook 'org-mode-hook #'display-line-numbers-mode)

;; Export Org HTML without CSS generated by htmlize.
(setq org-html-htmlize-output-type nil)

;;; Files, completion, and interface

;; Remember recently opened files for the Space f r shortcut.
(recentf-mode 1)

;; Keep minibuffer history, including M-x and Fido prompts, across restarts.
(savehist-mode 1)

;; Reopen files at the last visited position.
(save-place-mode 1)

;; Use a vertical, fuzzy-matching completion list in the minibuffer.
(fido-vertical-mode 1)

;; Flash the screen instead of ringing the bell.
(setq visible-bell t)
